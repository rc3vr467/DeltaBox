<!-- DeltaBox v3: nav icon tint — brand accent when selected, secondary text otherwise -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/delta_nav_selected_icon" android:state_checked="true" />
    <item android:color="@color/delta_nav_unselected_icon" android:state_checked="false" />
</selector>
