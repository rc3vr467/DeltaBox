<?xml version="1.0" encoding="utf-8"?>
<!-- Glass panel behind the connection info: soft vertical gradient + hairline border -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/delta_glass_bottom"
        android:startColor="@color/delta_glass_top" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="@color/delta_glass_stroke" />
</shape>
