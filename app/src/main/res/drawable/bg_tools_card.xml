<?xml version="1.0" encoding="utf-8"?>
<!-- Tool tile: card surface + hairline stroke, ripple on press -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/delta_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/delta_card" />
            <stroke android:width="1dp" android:color="@color/delta_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
