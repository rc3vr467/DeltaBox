<?xml version="1.0" encoding="utf-8"?>
<!-- Connecting: cat turns blue, eyes half open. Ends in the blue half-glow look. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_cat_base">
    <target android:name="cat_ears">
        <aapt:attr name="android:animation">
            <set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
                    <objectAnimator
                        android:duration="@android:integer/config_mediumAnimTime"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="strokeColor"
                        android:valueFrom="@color/cat_red"
                        android:valueTo="@color/cat_blue"
                        android:valueType="colorType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="cat_head">
        <aapt:attr name="android:animation">
            <set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
                    <objectAnimator
                        android:duration="@android:integer/config_mediumAnimTime"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="strokeColor"
                        android:valueFrom="@color/cat_red"
                        android:valueTo="@color/cat_blue"
                        android:valueType="colorType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="cat_mouth">
        <aapt:attr name="android:animation">
            <set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
                    <objectAnimator
                        android:duration="@android:integer/config_mediumAnimTime"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="strokeColor"
                        android:valueFrom="@color/cat_red_soft"
                        android:valueTo="@color/cat_blue_soft"
                        android:valueType="colorType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="aura_ring">
        <aapt:attr name="android:animation">
            <set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
                    <objectAnimator
                        android:duration="@android:integer/config_mediumAnimTime"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="strokeColor"
                        android:valueFrom="@color/cat_red"
                        android:valueTo="@color/cat_blue"
                        android:valueType="colorType" />
                    <objectAnimator
                        android:duration="@android:integer/config_mediumAnimTime"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="strokeAlpha"
                        android:valueFrom="0.0"
                        android:valueTo="0.0"
                        android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="aura_disc">
        <aapt:attr name="android:animation">
            <set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
                    <objectAnimator
                        android:duration="@android:integer/config_mediumAnimTime"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="fillColor"
                        android:valueFrom="@color/cat_red"
                        android:valueTo="@color/cat_blue"
                        android:valueType="colorType" />
                    <objectAnimator
                        android:duration="@android:integer/config_mediumAnimTime"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="fillAlpha"
                        android:valueFrom="0.10"
                        android:valueTo="0.10"
                        android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="eye_l_off">
        <aapt:attr name="android:animation">
            <set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
                    <objectAnimator
                        android:duration="@android:integer/config_mediumAnimTime"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="strokeColor"
                        android:valueFrom="@color/cat_red_soft"
                        android:valueTo="@color/cat_blue_soft"
                        android:valueType="colorType" />
                    <objectAnimator
                        android:duration="@android:integer/config_mediumAnimTime"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="strokeAlpha"
                        android:valueFrom="1"
                        android:valueTo="0"
                        android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="eye_l_halo">
        <aapt:attr name="android:animation">
            <set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
                    <objectAnimator
                        android:duration="@android:integer/config_mediumAnimTime"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="fillColor"
                        android:valueFrom="@color/cat_red"
                        android:valueTo="@color/cat_blue"
                        android:valueType="colorType" />
                    <objectAnimator
                        android:duration="@android:integer/config_mediumAnimTime"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="fillAlpha"
                        android:valueFrom="0"
                        android:valueTo="0.18"
                        android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="eye_l_core">
        <aapt:attr name="android:animation">
            <set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
                    <objectAnimator
                        android:duration="@android:integer/config_mediumAnimTime"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="fillColor"
                        android:valueFrom="@color/cat_red_soft"
                        android:valueTo="@color/cat_blue_soft"
                        android:valueType="colorType" />
                    <objectAnimator
                        android:duration="@android:integer/config_mediumAnimTime"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="fillAlpha"
                        android:valueFrom="0"
                        android:valueTo="0.6"
                        android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="eye_r_off">
        <aapt:attr name="android:animation">
            <set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
                    <objectAnimator
                        android:duration="@android:integer/config_mediumAnimTime"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="strokeColor"
                        android:valueFrom="@color/cat_red_soft"
                        android:valueTo="@color/cat_blue_soft"
                        android:valueType="colorType" />
                    <objectAnimator
                        android:duration="@android:integer/config_mediumAnimTime"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="strokeAlpha"
                        android:valueFrom="1"
                        android:valueTo="0"
                        android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="eye_r_halo">
        <aapt:attr name="android:animation">
            <set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
                    <objectAnimator
                        android:duration="@android:integer/config_mediumAnimTime"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="fillColor"
                        android:valueFrom="@color/cat_red"
                        android:valueTo="@color/cat_blue"
                        android:valueType="colorType" />
                    <objectAnimator
                        android:duration="@android:integer/config_mediumAnimTime"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="fillAlpha"
                        android:valueFrom="0"
                        android:valueTo="0.18"
                        android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="eye_r_core">
        <aapt:attr name="android:animation">
            <set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
                    <objectAnimator
                        android:duration="@android:integer/config_mediumAnimTime"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="fillColor"
                        android:valueFrom="@color/cat_red_soft"
                        android:valueTo="@color/cat_blue_soft"
                        android:valueType="colorType" />
                    <objectAnimator
                        android:duration="@android:integer/config_mediumAnimTime"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="fillAlpha"
                        android:valueFrom="0"
                        android:valueTo="0.6"
                        android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
