<?xml version="1.0" encoding="utf-8"?>
<!-- DeltaBox v3 — Main layout with redesigned Navigation Drawer -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="start">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/fragment_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Progress ring around the connect button -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/fabProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:max="1"
            android:visibility="invisible"
            app:indicatorColor="@color/delta_state_connecting"
            app:layout_anchor="@+id/fab"
            app:layout_anchorGravity="center"
            app:layout_behavior="io.nekohasekai.sagernet.widget.FabProgressBehavior"
            app:trackColor="@color/delta_stroke"
            app:trackCornerRadius="@dimen/mtrl_progress_track_thickness"
            app:trackThickness="8dp" />

        <!-- Connect button -->
        <io.nekohasekai.sagernet.widget.ServiceButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="8dp"
            android:nextFocusDown="@+id/stats"
            android:foreground="@drawable/bg_connect_rings"
            app:backgroundTint="@color/delta_connect_fill"
            app:borderWidth="0dp"
            app:fabCustomSize="104dp"
            app:layout_anchor="@id/stats"
            app:maxImageSize="80dp"
            app:pressedTranslationZ="8dp"
            app:rippleColor="@color/delta_glow"
            app:srcCompat="@drawable/ic_cat_base"
            app:tint="@null" />

        <!-- Status panel -->
        <io.nekohasekai.sagernet.widget.StatsBar
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:nextFocusUp="@+id/fab"
            app:backgroundTint="@color/delta_bar_off"
            app:contentInsetStart="0dp"
            app:elevation="8dp"
            app:fabCradleMargin="8dp"
            app:fabCradleRoundedCornerRadius="60dp"
            app:fabCradleVerticalOffset="0dp"
            app:hideOnScroll="true"
            app:layout_scrollFlags="enterAlways|scroll">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="96dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <!-- Left: exit country, connected server address, live ping -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/statusDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_status_dot"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/exitFlag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:importantForAccessibility="no"
                            android:textSize="16sp"
                            android:visibility="gone"
                            tools:text="🇹🇷" />

                        <TextView
                            android:id="@+id/status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Delta.StatsStatus"
                            android:textColor="@color/delta_bar_text"
                            android:textSize="14sp"
                            tools:text="United Kingdom" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/serverAddr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFeatureSettings="tnum"
                        android:singleLine="true"
                        android:textColor="@color/delta_bar_neon"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="uk4.0a0.uk:51000" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ping"
                            android:textColor="@color/delta_bar_text"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/pingValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFeatureSettings="tnum"
                            android:singleLine="true"
                            android:textColor="@color/delta_bar_muted"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="149 ms" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="@color/delta_bar_divider" />

                        <TextView
                            android:id="@+id/pingSignal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:singleLine="true"
                            android:textSize="12sp"
                            tools:text="▁▃▅▇" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Centre gap reserved for the floating connect button -->
                <Space
                    android:layout_width="116dp"
                    android:layout_height="1dp" />

                <!-- Right: live traffic -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▲  Upload"
                            android:textColor="@color/delta_bar_text"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tx"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:ellipsize="marquee"
                            android:fontFeatureSettings="tnum"
                            android:singleLine="true"
                            android:textColor="@color/delta_bar_neon"
                            android:textSize="12sp"
                            tools:text="7.67 kB/s" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"
                        android:background="@color/delta_bar_divider" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▼  Download"
                            android:textColor="@color/delta_bar_text"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/rx"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:ellipsize="marquee"
                            android:fontFeatureSettings="tnum"
                            android:singleLine="true"
                            android:textColor="@color/delta_bar_neon"
                            android:textSize="12sp"
                            tools:text="6.56 kB/s" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </io.nekohasekai.sagernet.widget.StatsBar>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- ═══════════════════════════════════════════════
         DeltaBox v3 — Premium Navigation Drawer
         with header, grouped items and footer
         ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/nav_drawer_container"
        android:layout_width="288dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/delta_nav_bg"
        android:fitsSystemWindows="true">

        <!-- Header: Brand identity -->
        <include layout="@layout/layout_nav_header" />

        <!-- Thin divider below header -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/delta_nav_divider"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="8dp" />

        <!-- Scrollable menu content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="8dp">

                <!-- Group: Main management -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MANAGE"
                    android:textColor="@color/delta_nav_footer_text"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:paddingStart="28dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp" />

                <!-- NavigationView for main items -->
                <com.google.android.material.navigation.NavigationView
                    android:id="@+id/nav_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:elevation="0dp"
                    android:outlineProvider="none"
                    android:fitsSystemWindows="false"
                    app:elevation="0dp"
                    app:insetForeground="@android:color/transparent"
                    app:itemHorizontalPadding="12dp"
                    app:itemIconPadding="14dp"
                    app:itemIconTint="@color/navigation_icon"
                    app:itemShapeAppearance="@style/ShapeAppearance.Delta.Medium"
                    app:itemShapeFillColor="@color/navigation_item"
                    app:itemShapeInsetBottom="2dp"
                    app:itemShapeInsetEnd="8dp"
                    app:itemShapeInsetStart="8dp"
                    app:itemShapeInsetTop="2dp"
                    app:itemTextAppearance="@style/TextAppearance.Delta.Nav"
                    app:itemTextColor="@color/navigation_icon"
                    app:itemVerticalPadding="12dp"
                    app:menu="@menu/main_drawer_menu_primary" />

                <!-- Thin divider between sections -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/delta_nav_divider"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />

                <!-- Group: System tools -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOOLS"
                    android:textColor="@color/delta_nav_footer_text"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:paddingStart="28dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp" />

                <com.google.android.material.navigation.NavigationView
                    android:id="@+id/nav_view_tools"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:elevation="0dp"
                    android:outlineProvider="none"
                    android:fitsSystemWindows="false"
                    app:elevation="0dp"
                    app:insetForeground="@android:color/transparent"
                    app:itemHorizontalPadding="12dp"
                    app:itemIconPadding="14dp"
                    app:itemIconTint="@color/navigation_icon"
                    app:itemShapeAppearance="@style/ShapeAppearance.Delta.Medium"
                    app:itemShapeFillColor="@color/navigation_item"
                    app:itemShapeInsetBottom="2dp"
                    app:itemShapeInsetEnd="8dp"
                    app:itemShapeInsetStart="8dp"
                    app:itemShapeInsetTop="2dp"
                    app:itemTextAppearance="@style/TextAppearance.Delta.Nav"
                    app:itemTextColor="@color/navigation_icon"
                    app:itemVerticalPadding="12dp"
                    app:menu="@menu/main_drawer_menu_tools" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Black wall variant (keep for compatibility) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view_black"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:visibility="gone"
        app:itemHorizontalPadding="12dp"
        app:itemIconPadding="14dp"
        app:itemIconTint="@color/navigation_icon"
        app:itemShapeAppearance="@style/ShapeAppearance.Delta.Medium"
        app:itemShapeFillColor="@color/navigation_item"
        app:itemShapeInsetBottom="2dp"
        app:itemShapeInsetEnd="8dp"
        app:itemShapeInsetStart="8dp"
        app:itemShapeInsetTop="2dp"
        app:itemTextAppearance="@style/TextAppearance.Delta.Nav"
        app:itemTextColor="@color/navigation_icon"
        app:itemVerticalPadding="12dp"
        app:menu="@menu/main_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
