<?xml version="1.0" encoding="utf-8"?>
<!-- DeltaBox v3 — Main layout with redesigned Navigation Drawer -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="start">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/fragment_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Progress ring around the connect button -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/fabProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:max="1"
            android:visibility="gone"
            app:indicatorColor="@color/delta_state_connecting"
            app:layout_anchor="@+id/fab"
            app:layout_anchorGravity="center"
            app:layout_behavior="io.nekohasekai.sagernet.widget.FabProgressBehavior"
            app:trackColor="@color/delta_stroke"
            app:trackCornerRadius="@dimen/mtrl_progress_track_thickness"
            app:trackThickness="8dp" />

        <!-- Connect button -->
        <io.nekohasekai.sagernet.widget.ServiceButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="8dp"
            android:nextFocusDown="@+id/stats"
            app:backgroundTint="?fabColorBackground"
            app:borderWidth="0dp"
            app:fabCustomSize="60dp"
            app:layout_anchor="@id/stats"
            app:maxImageSize="60dp"
            app:pressedTranslationZ="8dp"
            app:rippleColor="@color/delta_glow"
            app:srcCompat="@drawable/ic_cat_base"
            app:tint="@null" />

        <!-- Status panel -->
        <io.nekohasekai.sagernet.widget.StatsBar
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:nextFocusUp="@+id/fab"
            app:backgroundTint="@color/delta_card"
            app:contentInsetStart="0dp"
            app:elevation="8dp"
            app:fabCradleMargin="10dp"
            app:fabCradleRoundedCornerRadius="34dp"
            app:fabCradleVerticalOffset="4dp"
            app:hideOnScroll="true"
            app:layout_scrollFlags="enterAlways|scroll">

            <!-- DeltaBox 1.0.15: status row (unchanged) + live traffic chart below it -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="84dp"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/statusDot"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_status_dot"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.Delta.StatsStatus"
                            tools:text="@string/connection_test_available" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/exitIp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="2dp"
                        android:singleLine="true"
                        android:textColor="@color/delta_state_on_text"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="65.21.155.153" />

                    <TextView
                        android:id="@+id/pingBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_ping_badge"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.Delta.PingBadge"
                        tools:text="PING 45 ms" />
                </LinearLayout>

                <Space
                    android:layout_width="88dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tx"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:fontFeatureSettings="tnum"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.Delta.StatsValue" />

                    <TextView
                        android:id="@+id/rx"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="marquee"
                        android:fontFeatureSettings="tnum"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.Delta.StatsValue" />
                </LinearLayout>

            </LinearLayout>

                <TextView
                    android:id="@+id/trafficTotals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:fontFeatureSettings="tnum"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Delta.StatsValue"
                    android:textColor="@color/delta_chart_label"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="Session  ▲ 1.2 MB  ▼ 8.4 MB"
                    tools:visibility="visible" />

                <io.nekohasekai.sagernet.widget.TrafficChartView
                    android:id="@+id/trafficChart"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="10dp"
                    android:importantForAccessibility="no"
                    android:layoutDirection="ltr"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

        </io.nekohasekai.sagernet.widget.StatsBar>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- ═══════════════════════════════════════════════
         DeltaBox v3 — Premium Navigation Drawer
         with header, grouped items and footer
         ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/nav_drawer_container"
        android:layout_width="288dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/delta_nav_bg"
        android:fitsSystemWindows="true">

        <!-- Header: Brand identity -->
        <include layout="@layout/layout_nav_header" />

        <!-- Thin divider below header -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/delta_nav_divider"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="8dp" />

        <!-- Scrollable menu content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="8dp">

                <!-- Group: Main management -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MANAGE"
                    android:textColor="@color/delta_nav_footer_text"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:paddingStart="28dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp" />

                <!-- NavigationView for main items -->
                <com.google.android.material.navigation.NavigationView
                    android:id="@+id/nav_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:elevation="0dp"
                    android:outlineProvider="none"
                    android:fitsSystemWindows="false"
                    app:elevation="0dp"
                    app:insetForeground="@android:color/transparent"
                    app:itemHorizontalPadding="12dp"
                    app:itemIconPadding="14dp"
                    app:itemIconTint="@color/navigation_icon"
                    app:itemShapeAppearance="@style/ShapeAppearance.Delta.Medium"
                    app:itemShapeFillColor="@color/navigation_item"
                    app:itemShapeInsetBottom="2dp"
                    app:itemShapeInsetEnd="8dp"
                    app:itemShapeInsetStart="8dp"
                    app:itemShapeInsetTop="2dp"
                    app:itemTextAppearance="@style/TextAppearance.Delta.Nav"
                    app:itemTextColor="@color/navigation_icon"
                    app:itemVerticalPadding="12dp"
                    app:menu="@menu/main_drawer_menu_primary" />

                <!-- Thin divider between sections -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/delta_nav_divider"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />

                <!-- Group: System tools -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOOLS"
                    android:textColor="@color/delta_nav_footer_text"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:paddingStart="28dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp" />

                <com.google.android.material.navigation.NavigationView
                    android:id="@+id/nav_view_tools"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:elevation="0dp"
                    android:outlineProvider="none"
                    android:fitsSystemWindows="false"
                    app:elevation="0dp"
                    app:insetForeground="@android:color/transparent"
                    app:itemHorizontalPadding="12dp"
                    app:itemIconPadding="14dp"
                    app:itemIconTint="@color/navigation_icon"
                    app:itemShapeAppearance="@style/ShapeAppearance.Delta.Medium"
                    app:itemShapeFillColor="@color/navigation_item"
                    app:itemShapeInsetBottom="2dp"
                    app:itemShapeInsetEnd="8dp"
                    app:itemShapeInsetStart="8dp"
                    app:itemShapeInsetTop="2dp"
                    app:itemTextAppearance="@style/TextAppearance.Delta.Nav"
                    app:itemTextColor="@color/navigation_icon"
                    app:itemVerticalPadding="12dp"
                    app:menu="@menu/main_drawer_menu_tools" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Black wall variant (keep for compatibility) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view_black"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:visibility="gone"
        app:itemHorizontalPadding="12dp"
        app:itemIconPadding="14dp"
        app:itemIconTint="@color/navigation_icon"
        app:itemShapeAppearance="@style/ShapeAppearance.Delta.Medium"
        app:itemShapeFillColor="@color/navigation_item"
        app:itemShapeInsetBottom="2dp"
        app:itemShapeInsetEnd="8dp"
        app:itemShapeInsetStart="8dp"
        app:itemShapeInsetTop="2dp"
        app:itemTextAppearance="@style/TextAppearance.Delta.Nav"
        app:itemTextColor="@color/navigation_icon"
        app:itemVerticalPadding="12dp"
        app:menu="@menu/main_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
