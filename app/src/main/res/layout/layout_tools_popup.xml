<?xml version="1.0" encoding="utf-8"?>
<!-- DeltaBox v3 — Premium Tools Popup (BottomSheet-style grouped panel) -->
<!-- This layout is inflated by ConfigurationFragment to replace the flat popup menu -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/delta_tools_bg"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- ── Group 1: Subscription Management ── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SUBSCRIPTION"
        android:textColor="@color/delta_tools_header_text"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.12"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />

    <!-- Update Subscription -->
    <LinearLayout
        android:id="@+id/tools_update_subscription"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tools_icon_container_primary">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_baseline_refresh_24"
                android:tint="@color/delta_tools_icon_primary"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/update_current_subscription"
            android:textColor="@color/delta_text"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- ── Divider ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/delta_tools_divider"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- ── Group 2: Server Testing ── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SERVER TESTING"
        android:textColor="@color/delta_tools_header_text"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.12"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp" />

    <!-- TCPing -->
    <LinearLayout
        android:id="@+id/tools_tcping"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tools_icon_container_primary">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_baseline_speed_24"
                android:tint="@color/delta_tools_icon_primary"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/connection_test_tcp_ping"
            android:textColor="@color/delta_text"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- URL Test -->
    <LinearLayout
        android:id="@+id/tools_url_test"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tools_icon_container_primary">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_baseline_speed_24"
                android:tint="@color/delta_tools_icon_primary"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/connection_test_url_test"
            android:textColor="@color/delta_text"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- ── Divider ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/delta_tools_divider"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- ── Group 3: Maintenance & Cleanup ── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MAINTENANCE"
        android:textColor="@color/delta_tools_header_text"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.12"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp" />

    <!-- Clear Traffic Statistics -->
    <LinearLayout
        android:id="@+id/tools_clear_traffic"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tools_icon_container_neutral">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_baseline_multiline_chart_24"
                android:tint="@color/delta_text_secondary"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/clear_traffic_statistics"
            android:textColor="@color/delta_text"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Remove Duplicate Servers -->
    <LinearLayout
        android:id="@+id/tools_remove_duplicate"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tools_icon_container_neutral">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_baseline_layers_24"
                android:tint="@color/delta_text_secondary"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/remove_duplicate"
            android:textColor="@color/delta_text"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Clear Test Results -->
    <LinearLayout
        android:id="@+id/tools_clear_results"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tools_icon_container_neutral">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_baseline_refresh_24"
                android:tint="@color/delta_text_secondary"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/connection_test_clear_results"
            android:textColor="@color/delta_text"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Clear Unavailable -->
    <LinearLayout
        android:id="@+id/tools_clear_unavailable"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tools_icon_container_danger">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/baseline_delete_sweep_24"
                android:tint="@color/delta_tools_icon_danger"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/connection_test_delete_unavailable"
            android:textColor="@color/delta_tools_icon_danger"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- ── Divider ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/delta_tools_divider"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- ── Group 4: Organization ── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ORGANIZATION"
        android:textColor="@color/delta_tools_header_text"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.12"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp" />

    <!-- Order -->
    <LinearLayout
        android:id="@+id/tools_order"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tools_icon_container_primary">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_baseline_view_list_24"
                android:tint="@color/delta_tools_icon_primary"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/group_order"
            android:textColor="@color/delta_text"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_pref_chevron"
            android:tint="@color/delta_text_secondary"
            android:importantForAccessibility="no" />

    </LinearLayout>

    <Space android:layout_width="match_parent" android:layout_height="8dp" />

</LinearLayout>
