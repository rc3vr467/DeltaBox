<?xml version="1.0" encoding="utf-8"?>
<!-- DeltaBox v3 design system — display-only styles; no VPN logic touched. -->
<resources>

    <!-- ── Radius scale ── -->
    <style name="ShapeAppearance.Delta.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Delta.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Delta.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="DeltaDialogShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Toolbar overlay -->
    <style name="ThemeOverlay.Delta.ActionBar" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="colorControlNormal">@color/delta_brand</item>
    </style>

    <!-- ── Cards ── -->
    <!-- Fallback alias: any bare @style/Widget.Delta resolves to the Delta card style. -->
    <style name="Widget.Delta" parent="Widget.Delta.Card" />

    <style name="Widget.Delta.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/delta_card</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="strokeColor">@color/delta_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/delta_selected</item>
    </style>

    <!-- ── Buttons ── -->
    <style name="Widget.Delta.Button" parent="Widget.MaterialComponents.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.Delta.Small</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Delta.Button.Colored" parent="Widget.AppCompat.Button.Colored">
        <item name="backgroundTint">@color/delta_brand_dark</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ── Typography ── -->
    <style name="TextAppearance.Delta.Toolbar" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/delta_brand</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Delta.StatsValue" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/delta_text_secondary</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Delta.StatsStatus" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/delta_text</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Delta.CardTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/delta_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Delta.CardMeta" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/delta_text_secondary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Delta.PingBadge" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- ── Navigation ── -->
    <style name="TextAppearance.Delta.Nav" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ── Settings group header ── -->
    <style name="TextAppearance.Delta.SettingsGroup" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/delta_settings_group_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- ── Tools popup group label ── -->
    <style name="TextAppearance.Delta.ToolsGroup" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/delta_tools_header_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.12</item>
    </style>


    <!-- ── Popup / overflow menus: tokens instead of the generic DayNight overlay ── -->
    <style name="Widget.Delta.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_delta_popup</item>
        <item name="android:popupElevation">8dp</item>
    </style>

    <style name="ThemeOverlay.Delta.Popup" parent="ThemeOverlay.AppCompat.DayNight">
        <item name="android:colorBackground">@color/delta_popup_bg</item>
        <item name="colorBackgroundFloating">@color/delta_popup_bg</item>
        <item name="android:textColorPrimary">@color/delta_text</item>
        <item name="android:textColorSecondary">@color/delta_text_secondary</item>
        <item name="colorControlNormal">@color/delta_text_secondary</item>
        <item name="popupMenuStyle">@style/Widget.Delta.PopupMenu</item>
    </style>

    <!-- Dashboard quick-settings chip -->
    <style name="Widget.Delta.QuickChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/bg_quick_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/delta_text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
